# ── Base ────────────────────────────────────────────────────────────────────
APP_NAME=Weldix API
ENVIRONMENT=dev   # dev | prod

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./weldix.db
# Producción: DATABASE_URL=postgresql://user:password@host:5432/weldix
AUTO_CREATE_TABLES=true

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Seed admin (opcional) ────────────────────────────────────────────────────
SEED_ADMIN_ON_STARTUP=false
SEED_ADMIN_EMAIL=admin@weldix.com
SEED_ADMIN_PASSWORD=cambia_esta_password
SEED_ADMIN_FULL_NAME=Admin Weldix

# ── Seguridad login ───────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174"]
# Producción: ALLOWED_ORIGINS=["https://app.weldix.com"]

# ── Mistral IA ────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=

# ── Resend (emails transaccionales) ──────────────────────────────────────────
# Cuenta gratis en https://resend.com → API Keys → Create API Key (3000 emails/mes gratis)
# En dev puedes usar "onboarding@resend.dev" como EMAIL_FROM sin verificar dominio
RESEND_API_KEY=pegar_aqui_re_api_key_de_resend
EMAIL_FROM=Weldix <hola@weldix.app>

# ── Stripe (pagos) ────────────────────────────────────────────────────────────
# Obtener en: https://dashboard.stripe.com/apikeys
# Usar claves sk_test_... en desarrollo, sk_live_... en producción
STRIPE_SECRET_KEY=pegar_aqui_sk_test_de_stripe
# Obtener en: https://dashboard.stripe.com/webhooks → tu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=pegar_aqui_whsec_de_stripe
# Crear productos/precios en: https://dashboard.stripe.com/products
STRIPE_PRICE_STARTER=pegar_aqui_price_id_starter
STRIPE_PRICE_PRO=pegar_aqui_price_id_pro
# URL base del frontend (para redirigir tras checkout)
FRONTEND_URL=http://localhost:5174
