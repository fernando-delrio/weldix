# ── Base ────────────────────────────────────────────────────────────────────
APP_NAME=Weldix API
ENVIRONMENT=dev   # dev | prod

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./weldix.db
# Produccion: DATABASE_URL=postgresql+psycopg://user:password@host:5432/weldix
AUTO_CREATE_TABLES=true
# Produccion: AUTO_CREATE_TABLES=false y ejecutar `alembic upgrade head`

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Seed admin (opcional) ────────────────────────────────────────────────────
SEED_ADMIN_ON_STARTUP=false
SEED_ADMIN_EMAIL=admin@weldix.com
SEED_ADMIN_PASSWORD=cambia_esta_password
SEED_ADMIN_FULL_NAME=Admin Weldix

# ── Seguridad login ───────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174"]
# Producción: ALLOWED_ORIGINS=["https://app.weldix.com"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# Produccion: ALLOWED_HOSTS=["api.weldix.com"]
FORCE_HTTPS=false
# Produccion detras de proxy HTTPS: FORCE_HTTPS=true

# Uploads
MAX_UPLOAD_MB=10
# Nginx/proxy equivalente: client_max_body_size 10m;
# Directorio base de archivos subidos (fotos, nominas)
MEDIA_BASE_DIR=media
# Produccion (Render Persistent Disk montado en /opt/render/project/src/media):
# MEDIA_BASE_DIR=/opt/render/project/src/media

# ── Mistral IA ────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=

# ── Resend (emails transaccionales) ──────────────────────────────────────────
# Cuenta gratis en https://resend.com → API Keys → Create API Key (3000 emails/mes gratis)
# En dev puedes usar "onboarding@resend.dev" como EMAIL_FROM sin verificar dominio
RESEND_API_KEY=pegar_aqui_re_api_key_de_resend
EMAIL_FROM=Weldix <hola@weldix.app>

# ── n8n (automatizaciones: WhatsApp, email cliente, alertas stock, etc.) ──────
# Levantar con: docker compose up -d
# Admin panel: http://localhost:5678  (user: admin / pass: weldix2024)
# 1. Entra en n8n → New Workflow → Add node → "Webhook"
# 2. Copia la URL que te da n8n (ej: http://localhost:5678/webhook/abc123/job_listo)
# 3. Pon aquí la URL base SIN el nombre del evento final:
#    Si n8n te da  http://localhost:5678/webhook/abc123/job_listo
#    pon aquí      http://localhost:5678/webhook/abc123
# 4. El backend añade automáticamente /job_listo, /stock_bajo, /workspace_creado
N8N_WEBHOOK_URL=

# ── Stripe (pagos) ────────────────────────────────────────────────────────────
# Obtener en: https://dashboard.stripe.com/apikeys
# Usar claves sk_test_... en desarrollo, sk_live_... en producción
STRIPE_SECRET_KEY=pegar_aqui_sk_test_de_stripe
# Obtener en: https://dashboard.stripe.com/webhooks → tu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=pegar_aqui_whsec_de_stripe
# Crear productos/precios en: https://dashboard.stripe.com/products
STRIPE_PRICE_BASE=pegar_aqui_price_id_base_fija
STRIPE_PRICE_PER_SEAT=pegar_aqui_price_id_por_operario
# URL base del frontend (para redirigir tras checkout)
FRONTEND_URL=http://localhost:5174

# ── Super-admin (panel founder /superadmin) ──────────────────────────────────
# Clave secreta larga para acceder al panel de todos los workspaces.
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
SUPERADMIN_KEY=
