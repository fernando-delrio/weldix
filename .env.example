# ── Base ────────────────────────────────────────────────────────────────────
APP_NAME=Weldix API
ENVIRONMENT=dev   # dev | prod

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./weldix.db
# Producción: DATABASE_URL=postgresql://user:password@host:5432/weldix
AUTO_CREATE_TABLES=true

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Seed admin (opcional) ────────────────────────────────────────────────────
SEED_ADMIN_ON_STARTUP=false
SEED_ADMIN_EMAIL=admin@weldix.com
SEED_ADMIN_PASSWORD=cambia_esta_password
SEED_ADMIN_FULL_NAME=Admin Weldix

# ── Seguridad login ───────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173"]
# Producción: ALLOWED_ORIGINS=["https://app.weldix.com"]
